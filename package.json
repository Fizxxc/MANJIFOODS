    "postcss": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "vitest": "4.1.11",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "typescript-eslint": "8.70.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module"
