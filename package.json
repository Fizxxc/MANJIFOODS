    "test:smoke": "node scripts/smoke.mjs",
    "test:security": "node scripts/verify-auth-csp.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "tailwindcss": "3.4.19",
    "lucide-react": "0.577.0",
    "zod": "4.3.6",
    "react-hook-form": "7.85.0",
    "qrcode": "1.5.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/qrcode": "1.5.6",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
